{
  "name": "autodudes/ai-suite-mcp",
  "type": "typo3-cms-extension",
  "description": "AI Suite MCP - MCP (Model Context Protocol) server integration for TYPO3 and compatibility to EXT:ai_suite. Provides AI-powered tools for Claude Desktop, Claude.ai, ChatGPT, and other MCP clients.",
  "homepage": "https://www.autodudes.de/",
  "license": [
    "GPL-2.0-or-later"
  ],
  "authors": [
    {
      "name": "AutoDudes",
      "role": "Developer",
      "homepage": "https://www.autodudes.de",
      "email": "service@autodudes.de"
    }
  ],
  "support": {
    "email": "service@autodudes.de",
    "issues": "https://github.com/autodudesde/ai-suite-mcp/issues",
    "source": "https://github.com/autodudesde/ai-suite-mcp",
    "docs": "https://www.autodudes.de/en/documentation/ai-suite-mcp",
    "security": "https://github.com/autodudesde/ai-suite-mcp/security/policy"
  },
  "version": "0.13.1",
  "keywords": [
    "TYPO3 CMS",
    "MCP",
    "Model Context Protocol"
  ],
  "require": {
    "autodudes/ai-suite": "^12.26.0 || ^13.20.0 || ^14.8.0",
    "typo3/cms-core": "^12.4.11 || ^13.4.1 || ^14.3.0",
    "typo3/cms-reports": "^12.4.11 || ^13.4.1 || ^14.3.0",
    "typo3/cms-workspaces": "^12.4.11 || ^13.4.1 || ^14.3.0",
    "logiscape/mcp-sdk-php": "^2.0",
    "symfony/clock": "^6.4 || ^7.0 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "AutoDudes\\AiSuiteMcp\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AutoDudes\\AiSuiteMcp\\Tests\\": "Tests/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "ai_suite_mcp",
      "Package": {
        "providesPackages": {
          "logiscape/mcp-sdk-php": "Resources/Private/PHP/ComposerVendor",
          "symfony/clock": ""
        }
      }
    }
  }
}
