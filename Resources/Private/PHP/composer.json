{
  "name": "autodudes/ai-suite-mcp-classic-bundle",
  "description": "Third-party libraries of ai_suite_mcp for TYPO3 classic mode installations. Built by Build/bundle-libs.sh, not used in Composer mode.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "logiscape/mcp-sdk-php": "^2.0"
  },
  "replace": {
    "psr/clock": "*",
    "psr/log": "*",
    "symfony/clock": "*",
    "symfony/polyfill-mbstring": "*"
  },
  "config": {
    "vendor-dir": "ComposerVendor",
    "platform": {
      "php": "8.1.0"
    },
    "platform-check": false,
    "optimize-autoloader": true,
    "autoloader-suffix": "AiSuiteMcpClassicBundle",
    "sort-packages": true,
    "allow-plugins": false
  }
}
